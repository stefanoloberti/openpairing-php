{
  "name": "openpairing/openpairing-php",
  "description": "Deterministic, offline FIDE pairing engine for PHP",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "OpenPairing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenPairing\\Tests\\": "tests/",
      "OpenPairing\\Development\\Oracle\\": "tools/oracle/php/"
    }
  },
  "bin": [
    "bin/openpairing.php",
    "bin/openpairing-ptc.php",
    "bin/openpairing-rtg.php"
  ],
  "scripts": {
    "test": "@php vendor/phpunit/phpunit/phpunit --exclude-group oracle --exclude-group stress",
    "test-oracles": "@php vendor/phpunit/phpunit/phpunit --group oracle",
    "test-stress": "@php vendor/phpunit/phpunit/phpunit --group stress",
    "analyse": "@php vendor/phpstan/phpstan/phpstan analyse --memory-limit=512M",
    "check": [
      "@test",
      "@analyse"
    ],
    "checkpoint": [
      "@check",
      "@test-stress",
      "@test-oracles"
    ],
    "benchmark": "@php tools/benchmark.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}
