{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpairing.example/schema/thp-candidate-identity-1.schema.json",
  "title": "OpenPairing exact THP candidate identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidateName", "product", "package", "runtime", "standards", "artifacts"],
  "properties": {
    "schema": {"const": "openpairing.thp-candidate-identity/1"},
    "candidateName": {"type": "string", "minLength": 1},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sourceCommit", "fideMode"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sourceCommit": {"$ref": "#/$defs/gitCommit"},
        "fideMode": {"type": "string", "minLength": 1}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sourceCommit", "sourceTreeSha256", "engineVersion", "engineSha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sourceCommit": {"$ref": "#/$defs/gitCommit"},
        "sourceTreeSha256": {"$ref": "#/$defs/sha256"},
        "engineVersion": {"type": "string", "minLength": 1},
        "engineSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["osProfile", "phpVersion", "arithmeticBackend"],
      "properties": {
        "osProfile": {"type": "string", "minLength": 1},
        "phpVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+._A-Za-z0-9]*)?$"},
        "arithmeticBackend": {"enum": ["gmp", "limbs-30"]}
      }
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairingSystems", "trfVersions", "schemaVersions"],
      "properties": {
        "pairingSystems": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "trfVersions": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "schemaVersions": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"enum": ["product-installer", "openpairing-runtime", "ptc", "rtg"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
