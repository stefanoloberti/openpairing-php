{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpairing.example/schema/thp-pairing-request-1.schema.json",
  "title": "OpenPairing THP immutable pairing request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "jobId", "tournamentRevision", "candidateIdentitySha256", "submittedAtUtc", "snapshot"],
  "properties": {
    "schema": {"const": "openpairing.thp-pairing-request/1"},
    "jobId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{15,127}$"},
    "tournamentRevision": {"type": "string", "minLength": 1, "maxLength": 128},
    "candidateIdentitySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "submittedAtUtc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema", "round", "pairingSystem", "initialColour", "playerCount", "eligiblePlayerCount"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^/\\\\][^\\\\]*$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "schema": {"const": "openpairing.tournament/1"},
        "round": {"type": "integer", "minimum": 1, "maximum": 256},
        "pairingSystem": {"enum": ["fide-dutch-2026", "fide-burstein-2026"]},
        "initialColour": {"enum": ["white", "black"]},
        "playerCount": {"type": "integer", "minimum": 1, "maximum": 4096},
        "eligiblePlayerCount": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    }
  }
}
