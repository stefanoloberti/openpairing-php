{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpairing.example/schema/thp-precommit-observation-1.schema.json",
  "title": "OpenPairing THP pre-commit re-observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "jobId", "candidateIdentitySha256", "observedAtUtc", "tournamentRevision", "snapshot"],
  "properties": {
    "schema": {"const": "openpairing.thp-precommit-observation/1"},
    "jobId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{15,127}$"},
    "candidateIdentitySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observedAtUtc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "tournamentRevision": {"type": "string", "minLength": 1, "maxLength": 128},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^/\\\\][^\\\\]*$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
